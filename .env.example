# Copy this file to .env and fill in the values from your Supabase project
# (Supabase Dashboard -> Project Settings -> Data API / API Keys)
VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# Only needed to run `npm run upload-media`. The site itself never uses it.
#
# This is the service_role (secret) key. It bypasses row-level security
# entirely, which is why the upload script can write to the media table and
# the anon key above cannot.
#
# Do NOT put VITE_ in front of it. Vite publishes every VITE_-prefixed
# variable into the browser bundle, and a service key there would hand every
# visitor full read/write on your database. The name below is deliberate.
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
